# Bonus (Supabase): copie este arquivo para `.env` e preencha os dois valores.
# O `.env` esta no .gitignore e nunca vai para o repositorio.
#
# Sem estas variaveis o app roda em modo local (contas e colecao salvas no
# proprio aparelho) e todos os requisitos obrigatorios funcionam do mesmo jeito.
#
# Onde achar: painel do Supabase > Project Settings > API.
# A chave e a "publishable key" (nos paineis antigos, "anon public key").
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
